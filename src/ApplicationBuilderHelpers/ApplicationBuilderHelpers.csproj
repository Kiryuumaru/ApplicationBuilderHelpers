<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<LangVersion>14</LangVersion>
		<TargetFrameworks>net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<!-- AOT baseline net8+: IsAotCompatible is only meaningful where AOT
		     analysis/publish is supported. net6.0/net7.0 stay trimmable with
		     trim analysis on, but are not AOT-compat-declared. -->
		<IsAotCompatible Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net9.0' Or '$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
		<!-- Trim-analysis enforcement: IL2026/IL2070-family (trim/DAM dataflow) and
		     IL3050 (runtime-directed code) warnings fail the build so trim
		     diagnostics surface in Debug builds, not only in trimmed publishes. -->
		<WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2070;IL2072;IL2075;IL3050</WarningsAsErrors>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>Kiryuumaru</Authors>
		<Company>Kiryuumaru</Company>
		<Copyright>Kiryuumaru</Copyright>
		<Description>ApplicationBuilderHelpers for building an application with dependency injection.</Description>
		<PackageTags>ApplicationBuilderHelpers, Application, ApplicationBuilder, Helpers, DependencyInjection</PackageTags>
		<PackageProjectUrl>https://github.com/Kiryuumaru/ApplicationBuilderHelpers</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Kiryuumaru/ApplicationBuilderHelpers</RepositoryUrl>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE" Pack="true" PackagePath="" />
		<None Include="..\..\README.md" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AbsolutePathHelpers" Version="0.3.146" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="ApplicationBuilderHelpers.Test.Cli.UnitTest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ApplicationBuilderHelpers.Analyzers\ApplicationBuilderHelpers.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<!-- Ship the analyzer under analyzers/dotnet/cs so consumers fail the
	     build on ABH001 without a runtime dependency. The analyzer DLL path
	     is resolved from the analyzer project itself in the packing
	     configuration (no literal bin\$(Configuration) path), so pack can
	     never silently ship without the ABH001 gate (fail-open). The
	     ProjectReference above provides the compile-time build edge. -->
	<PropertyGroup>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_ResolveAnalyzerForPack</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>
	<!-- TfmSpecificPackageFile dedupes by file name across inner builds,
	     so the same analyzer resolved once per TFM logs NU5118 dupes and is
	     emitted only once. Resolve once (first TFM) to keep pack hermetic
	     without duplicate-file warnings. -->
	<Target Name="_ResolveAnalyzerForPack" Returns="@(TfmSpecificPackageFile)" Condition="'$(TargetFramework)' == 'net6.0'">
		<MSBuild Projects="..\ApplicationBuilderHelpers.Analyzers\ApplicationBuilderHelpers.Analyzers.csproj" Targets="GetTargetPathWithTargetPlatformMoniker" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;TargetFrameworks" SkipNonexistentTargets="false">
			<Output TaskParameter="TargetOutputs" ItemName="_AnalyzerToPack" />
		</MSBuild>
		<ItemGroup>
			<TfmSpecificPackageFile Include="@(_AnalyzerToPack)" PackagePath="analyzers/dotnet/cs" BuildAction="None" />
		</ItemGroup>
	</Target>

</Project>
